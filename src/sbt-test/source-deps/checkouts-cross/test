# lib3next replaces example:kit: of the projects publishing it (lib2_13, lib3, lib3next), it is the one
# that builds for the consumer's exact version, 3.8.4 (a 3.8 consumer cannot read 3.9 TASTy; lib3 would
# stay on 3.8.3). marker3 (not marker2_13) runs as the compiler plugin, passed as a jar
> run kit-3-next
$ exists marker-ran

# an edit in the checkout is compiled incrementally on the next run
$ copy-file changes/Kit.scala _checkouts/kit/lib3next/src/main/scala/kit/Kit.scala
> run kit-3b

# an edit in the compiler plugin recompiles the consumer (its sources are unchanged): the plugin jar is
# passed under a name holding its hash
$ copy-file changes/MarkerPlugin.scala _checkouts/kit/marker3/src/main/scala/marker/MarkerPlugin.scala
> run kit-3b
$ exists marker-ran-v2
